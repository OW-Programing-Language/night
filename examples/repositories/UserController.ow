@Controller
class UserController:
  @Inject
  field private users UserService

  # Register literal routes before /:id so the parameter route cannot
  # shadow the fixed /page endpoint in OW's ordered HTTP dispatcher.
  @GetMapping("/api/users/page")
  fn page():
    return: this.users.page(int(query("limit")), int(query("offset")))

  @GetMapping("/api/users")
  fn list():
    return: this.users.list()

  @GetMapping("/api/users/:id")
  fn find():
    return: this.users.find(int(param("id")))

  @PostMapping("/api/users/:id")
  fn create():
    set id int: int(param("id"))
    call: this.users.create(id, body())
    return: response(201, {id: id, created: 1})

  @PostMapping("/api/users/:id/fail")
  fn fail():
    set id int: int(param("id"))
    call: this.users.create_then_fail(id, body())
    return: {created: 1}

  @PostMapping("/api/users/:id/caught")
  fn caught():
    set id int: int(param("id"))
    call: this.users.catch_failure(id, body())
    return: {created: 1}
