module Production.Catalog: PROD_CATALOG
  fn name() -> string:
    return: "catalog"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 1
  fn start() -> int:
    return: 1
  fn stop() -> int:
    return: 1
  fn on_event(type string, payload int) -> int:
    return: 0
  fn price(item int) -> int:
    if: item == 1
      return: 12
    if: item == 2
      return: 19
    return: 0
  fn available(item int) -> int:
    if: item == 1
      return: 1
    if: item == 2
      return: 1
    return: 0
  fn mount() -> int:
    route "GET /api/catalog":
      if: night.is_active("catalog") == 0
        respond: response(503, {error: "catalog inactive"})
      respond: [{item: 1, price: 12}, {item: 2, price: 19}]
    return: 1
