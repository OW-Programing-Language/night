# Reusable input guard helpers. Route must explicitly return HTTP 400 on failure.
class NightValidation:
  fn new():
    return: 0

  fn required(value):
    return: extension("night.validation.required", value)

  fn max_length(value, limit):
    return: extension("night.validation.max_length", value, limit)

  # Declarative rules: [[field, type, required_0_or_1, max]], unknown fields denied.
  fn object(value, rules):
    return: extension("night.validation.object", value, rules)
