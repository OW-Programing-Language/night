# Night password credential store (bcrypt; PostgreSQL/H2 backing table).
# Import after running Flyway V3__night_credentials.sql.
# Service-only functions: NEVER expose issue_reset() as a public HTTP response.
# Authentication does not create an HTTP principal or session.
class NightCredentials:
  fn new():
    return: 0

  fn register(username, password):
    return: extension("night.credentials.register", username, password)

  fn verify(username, password):
    return: extension("night.credentials.verify", username, password)

  fn issue_reset(username):
    return: extension("night.credentials.issue_reset", username)

  fn complete_reset(username, token, new_password):
    return: extension("night.credentials.complete_reset", username, token, new_password)
