import "NightComponent.ow"

# Bridges a real OW native module into the Night lifecycle.
# Typed callers receive the ORIGINAL module through value() / NightApp.service.
# The contract label is only metadata: actual type checks happen in OW.
class NightNativeAdapter(NightComponent):
  field source
  field contract

  fn new(source, contract):
    set checked NIGHT_COMPONENT: source
    set this.source: checked
    set this.contract: contract
    return: 0

  fn name():
    return: this.source.name()

  fn requires():
    return: this.source.requires()

  fn register(app):
    return: this.source.register()

  fn start(app):
    return: this.source.start()

  fn mount():
    return: this.source.mount()

  fn stop(app):
    return: this.source.stop()

  fn on_event(type, payload):
    return: this.source.on_event(type, payload)

  fn value():
    return: this.source
