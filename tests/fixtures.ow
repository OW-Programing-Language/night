import "../src/NightApp.ow"

# Lightweight class modules for lifecycle regressions. These use the same
# public NightComponent interface as the native module adapter.
class BaseTestModule(NightComponent):
  fn new():
    return: 0
  fn name():
    return: "base"
  fn requires():
    return: []
  fn register(app):
    return: 0
  fn start(app):
    print: "START base"
    return: 0
  fn mount():
    return: 0
  fn stop(app):
    print: "STOP base"
    return: 0
  fn on_event(type, payload):
    return: 0
  fn value():
    return: this

class MiddleTestModule(NightComponent):
  fn new():
    return: 0
  fn name():
    return: "middle"
  fn requires():
    return: ["base"]
  fn register(app):
    return: 0
  fn start(app):
    print: "START middle"
    return: 0
  fn mount():
    return: 0
  fn stop(app):
    print: "STOP middle"
    return: 0
  fn on_event(type, payload):
    return: 0
  fn value():
    return: this

class LeafTestModule(NightComponent):
  fn new():
    return: 0
  fn name():
    return: "leaf"
  fn requires():
    return: ["middle"]
  fn register(app):
    return: 0
  fn start(app):
    print: "START leaf"
    return: 0
  fn mount():
    return: 0
  fn stop(app):
    print: "STOP leaf"
    return: 0
  fn on_event(type, payload):
    if: type == "test"
      print: "EVENT leaf " + payload
    return: 0
  fn value():
    return: this

class FailingTestModule(NightComponent):
  fn new():
    return: 0
  fn name():
    return: "failing"
  fn requires():
    return: ["base"]
  fn register(app):
    return: 0
  fn start(app):
    print: "FAIL failing"
    return: 0 - 1
  fn mount():
    return: 0
  fn stop(app):
    print: "ERROR: failed component cannot be stopped"
    return: 0
  fn on_event(type, payload):
    return: 0
  fn value():
    return: this

